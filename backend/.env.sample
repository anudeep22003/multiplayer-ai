# Copy to .env.local and run the backend from this directory.
# Exported environment variables take precedence over .env.local values.

APP_NAME=multiplayer-ai
APP_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# PostgreSQL connection and pool settings (matches compose.yaml defaults).
DATABASE_URL=postgres://multiplayer_ai:multiplayer_ai@localhost:5432/multiplayer_ai?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s
