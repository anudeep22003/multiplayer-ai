# Copy to .env.local and run the backend from this directory.
# Exported environment variables take precedence over .env.local values.

APP_NAME=conman
APP_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# Optional until database access is needed.
DATABASE_URL=
