# Copy to .env for local development.
# caarlos0/env reads process environment variables; it does not load .env files.
# To load these values in your shell: set -a; source .env; set +a

APP_NAME=conman
APP_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# Optional until database access is needed.
DATABASE_URL=
